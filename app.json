{
  "expo": {
    "name": "PaisaPilot",
    "slug": "PaisaPilot",
    "version": "1.0.0",
    "scheme": "paisapilot",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1729"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shahid310.PaisaPilot"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1729"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.shahid310.PaisaPilot"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LAUNCH",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/1eb90e68-fe72-474c-ab2f-f08d1ffbd592"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-updates"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1eb90e68-fe72-474c-ab2f-f08d1ffbd592"
      }
    }
  }
}
