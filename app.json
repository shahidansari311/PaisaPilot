{
  "expo": {
    "name": "PaisaPilot",
    "slug": "PaisaPilot",
    "version": "1.0.0",
    "scheme": "paisapilot",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shahid310.PaisaPilot"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1729"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shahid310.PaisaPilot"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/1eb90e68-fe72-474c-ab2f-f08d1ffbd592"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-updates",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "jsEngine": "hermes",
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "shrinkResources": true,
            "buildArchs": ["arm64-v8a"],
            "useLegacyPackaging": false,
            "gifEnabled": false,
            "webpEnabled": false
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1eb90e68-fe72-474c-ab2f-f08d1ffbd592"
      }
    }
  }
}
